diff --git a/projects/predictive-survival-26-1-2/src/client/java/dev/pixelied/survival/threat/WeaponSnapshot.java b/projects/predictive-survival-26-1-2/src/client/java/dev/pixelied/survival/threat/WeaponSnapshot.java
