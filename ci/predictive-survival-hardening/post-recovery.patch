diff --git a/projects/predictive-survival-26-1-2/src/client/java/dev/pixelied/survival/threat/GuardianBeamPredictor.java b/projects/predictive-survival-26-1-2/src/client/java/dev/pixelied/survival/threat/GuardianBeamPredictor.java
