Subject: [PATCH] test: assert source-faithful instant explosion postconditions

---
 .../validation/InstantExplosionGuardValidationScenarios.java | 5 +++--
 .../validation/SurvivalValidationClientGameTest.java          | 1 +
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/projects/predictive-survival-26-1-2/src/gametest/java/dev/pixelied/survival/validation/InstantExplosionGuardValidationScenarios.java b/projects/predictive-survival-26-1-2/src/gametest/java/dev/pixelied/survival/validation/InstantExplosionGuardValidationScenarios.java
--- a/projects/predictive-survival-26-1-2/src/gametest/java/dev/pixelied/survival/validation/InstantExplosionGuardValidationScenarios.java
+++ b/projects/predictive-survival-26-1-2/src/gametest/java/dev/pixelied/survival/validation/InstantExplosionGuardValidationScenarios.java
@@ -150,7 +150,7 @@ final class InstantExplosionGuardValidationScenarios {
                     true,
                     player.getHealth(),
                     player.getMainHandItem().isEmpty(),
-                    level.getBlockState(anchorPos).isAir()
+                    !level.getBlockState(anchorPos).is(Blocks.RESPAWN_ANCHOR)
                 );
             });
             assertProtectedExplosion("respawn_anchor", anchor);
@@ -238,7 +238,8 @@ final class InstantExplosionGuardValidationScenarios {
                     true,
                     player.getHealth(),
                     player.getMainHandItem().isEmpty(),
-                    nether.getBlockState(arena.head()).isAir() && nether.getBlockState(arena.foot()).isAir()
+                    !nether.getBlockState(arena.head()).is(Blocks.RED_BED)
+                        && !nether.getBlockState(arena.foot()).is(Blocks.RED_BED)
                 );
             });
             assertProtectedExplosion("explosive_bed", bed);
diff --git a/projects/predictive-survival-26-1-2/src/gametest/java/dev/pixelied/survival/validation/SurvivalValidationClientGameTest.java b/projects/predictive-survival-26-1-2/src/gametest/java/dev/pixelied/survival/validation/SurvivalValidationClientGameTest.java
--- a/projects/predictive-survival-26-1-2/src/gametest/java/dev/pixelied/survival/validation/SurvivalValidationClientGameTest.java
+++ b/projects/predictive-survival-26-1-2/src/gametest/java/dev/pixelied/survival/validation/SurvivalValidationClientGameTest.java
@@ -84,6 +84,7 @@ public final class SurvivalValidationClientGameTest implements FabricClientGameTest {
             results.addAll(LiveExplosionScalingValidationScenarios.runtimeSlice(context, singleplayer));
             MinecartTntValidationScenarios.validatePrimedMinecartProducesBoundedExplosionThreat(context, singleplayer);
             InstantExplosionGuardValidationScenarios.validateVisibleInstantSourcesArmBeforeDetonation(context, singleplayer);
+            waitForServerClientLoaded(context, singleplayer);
             validateHurtCooldown(singleplayer);
             validateDeathProtection(singleplayer, InteractionHand.MAIN_HAND);
             validateDeathProtection(singleplayer, InteractionHand.OFF_HAND);
