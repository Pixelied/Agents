@@ -0,0 +1,32 @@
+package dev.pixelied.survival;
+
+import java.util.Objects;
+
+/**
+ * Ensures Predictive Survival evaluates at most once during a Minecraft client tick.
+ * An urgent zero-warning trigger may consume the tick's evaluation before the normal
+ * END_CLIENT_TICK pass; otherwise END performs the normal evaluation.
+ */
+final class UrgentReevaluationGate {
+    private boolean evaluatedThisTick;
+
+    void startClientTick() {
+        evaluatedThisTick = false;
+    }
+
+    boolean tryUrgent(Runnable evaluation) {
+        return runOnce(evaluation);
+    }
+
+    boolean runRegularEnd(Runnable evaluation) {
+        return runOnce(evaluation);
+    }
+
+    private boolean runOnce(Runnable evaluation) {
+        Objects.requireNonNull(evaluation, "evaluation");
+        if (evaluatedThisTick) return false;
+        evaluatedThisTick = true;
+        evaluation.run();
+        return true;
+    }
+}
