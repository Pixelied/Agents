+package dev.adrien.speedbridge.stair;
+
+import dev.adrien.speedbridge.path.BridgeHeading;
+import dev.adrien.speedbridge.path.GridPos;
+import dev.adrien.speedbridge.path.PathStep;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class StaircaseOwnershipRegressionTest {
+    private static final PathStep STEP = new PathStep(
+            new GridPos(0, 5, -1), new GridPos(0, 6, -1), new BridgeHeading(0, -1));
+
+    @Test
+    void staleLowerFailureCannotReactivateAResetCycle() {
+        StaircaseCycle cycle = new StaircaseCycle();
+        cycle.start(STEP, 10);
+        cycle.reset();
+
+        cycle.lowerFailed();
+
+        assertFalse(cycle.active(), "a stale callback must not reactivate an idle cycle");
+        assertNull(cycle.step());
+    }
+
+    @Test
+    void staleUpperFailureCannotReactivateAResetCycle() {
+        StaircaseCycle cycle = new StaircaseCycle();
+        cycle.start(STEP, 10);
+        cycle.reset();
+
+        cycle.upperFailed();
+
+        assertFalse(cycle.active(), "a stale callback must not reactivate an idle cycle");
+        assertNull(cycle.step());
+    }
+
+    @Test
+    void everyPublicTransitionPreservesActiveImpliesStep() {
+        StaircaseCycle cycle = new StaircaseCycle();
+        assertInvariant(cycle);
+
+        cycle.start(STEP, 1);
+        assertInvariant(cycle);
+        cycle.lowerAttempted(2);
+        assertInvariant(cycle);
+        cycle.lowerFailed();
+        assertInvariant(cycle);
+        cycle.reset();
+        assertInvariant(cycle);
+
+        cycle.start(STEP, 3);
+        cycle.upperAttempted(4);
+        assertInvariant(cycle);
+        cycle.upperFailed();
+        assertInvariant(cycle);
+        cycle.reset();
+        assertInvariant(cycle);
+    }
+
+    private static void assertInvariant(StaircaseCycle cycle) {
+        assertTrue(!cycle.active() || cycle.step() != null,
+                "an active staircase cycle must always own a path step");
+    }
+}
