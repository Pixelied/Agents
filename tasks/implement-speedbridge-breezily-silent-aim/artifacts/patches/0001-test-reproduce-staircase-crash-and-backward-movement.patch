+package dev.adrien.speedbridge.controller;
+
+import dev.adrien.speedbridge.path.BridgeHeading;
+import dev.adrien.speedbridge.path.GridPos;
+import dev.adrien.speedbridge.path.PathStep;
+import dev.adrien.speedbridge.stair.StaircaseCycle;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class ControllerLifecycleRegressionTest {
+    private static final PathStep STEP = new PathStep(
+            new GridPos(0, 5, -1), new GridPos(0, 6, -1), new BridgeHeading(0, -1));
+
+    @Test
+    void timedOutPlacementFromAnAbortedCycleCannotCreateAnActiveNullStep() {
+        StaircaseCycle staircase = new StaircaseCycle();
+        staircase.start(STEP, 10);
+
+        staircase.reset(); // grounded abort clears the path step
+        staircase.lowerFailed(); // stale pending-placement timeout arrives later
+
+        assertFalse(staircase.active());
+        assertNull(staircase.step());
+    }
+}
