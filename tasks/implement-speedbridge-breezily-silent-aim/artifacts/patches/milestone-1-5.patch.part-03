--- /dev/null
+++ b/src/client/java/dev/adrien/speedbridge/mixin/ClientInputAccessor.java
@@ -0,0 +1,19 @@
+package dev.adrien.speedbridge.mixin;
+
+import net.minecraft.client.player.ClientInput;
+import net.minecraft.world.entity.player.Input;
+import net.minecraft.world.phys.Vec2;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.gen.Accessor;
+
+@Mixin(ClientInput.class)
+public interface ClientInputAccessor {
+    @Accessor("keyPresses")
+    Input speedbridge$getKeyPresses();
+
+    @Accessor("keyPresses")
+    void speedbridge$setKeyPresses(Input input);
+
+    @Accessor("moveVector")
+    void speedbridge$setMoveVector(Vec2 vector);
+}
