+        close(projection.leftImpulse(), -0.6, 1.0e-6);
+        close(projection.forwardImpulse(), -0.8, 1.0e-6);
+
+        MovementOverrideState.publish(
+                MovementFrame.fromReferenceYaw(0), new MovementCommand(-1, 0), 180);
+        check(MovementOverrideState.active());
+        check(!MovementOverrideState.relativeCommand().equals(MovementCommand.NONE));
+        MovementOverrideState.clear();
+        check(!MovementOverrideState.active());
+        equal(MovementOverrideState.relativeCommand(), MovementCommand.NONE);
+    }
+
+    private static void testTechniqueContracts() {
+        equal(TechniqueId.STANDARD.value(), "standard");
+        equal(TechniqueId.BREEZILY.value(), "breezily");
+        expectIllegalArgument(() -> new TechniqueId(" "));
+        expectIllegalArgument(() -> new TechniqueCapabilities(
+                true, false, true, false, false, true, true, true, false, false, true, -0.01, 0.5));
+
+        BridgeSession session = new BridgeSession(1, TechniqueId.STANDARD, 20);
+        BridgeContext context = new BridgeContextBuilder(session)
+                .player(new BridgeContext.PlayerSnapshot(
+                        new Vec2d(1.5, 2.5),
+                        new BridgeContext.Bounds3d(1.2, 5, 2.2, 1.8, 6.8, 2.8),
+                        Vec2d.ZERO, 0, true, true, false, false, false, false, false))
+                .physicalInput(new RawInputIntent(false, true, false, false, false, false, false))
+                .movementFrame(MovementFrame.fromReferenceYaw(0))
+                .headingDecision(new HeadingDecision(new BridgeHeading(0, -1), false))
+                .support(SupportSnapshot.empty(new Vec2d(1.5, 2.5), 5))
+                .pathAnchor(new GridPos(1, 4, 2))
+                .selectedBlock(new BridgeContext.SelectedBlockSnapshot(2, "minecraft:stone", true))
+                .blockCount(64).tick(40).screenOpen(false).focused(true)
+                .dimensionId("minecraft:overworld").dimensionChanged(false)
+                .serverCorrection(false).aimMode(AimMode.VISIBLE)
+                .placementResult(PlacementResult.NOT_REQUESTED).build();
+        equal(context.tick(), 40L);
+        equal(context.aimMode(), AimMode.VISIBLE);
+        equal(context.placementResult(), PlacementResult.NOT_REQUESTED);
+        check(context.player().alive());
+        check(new TechniqueId.BREEZILY.equals(TechniqueId.BREEZILY));
+        check(new TechniqueCapabilities(true, false, true, false, false,
+                true, true, true, false, false, true, 0.2, 0.7).supports(AimMode.SILENT_PACKET));
+
+        ArrayList<SupportShape> mutableShapes = new ArrayList<>();
+        BridgeContext copied = new BridgeContextBuilder(session)
+                .player(context.player()).physicalInput(context.physicalInput())
+                .movementFrame(context.movementFrame()).headingDecision(context.headingDecision())
+                .support(new SupportSnapshot(Vec2d.ZERO, Vec2d.ZERO, List.copyOf(mutableShapes), 5))
+                .pathAnchor(context.pathAnchor()).selectedBlock(context.selectedBlock())
+                .blockCount(1).tick(41).dimensionId("minecraft:overworld").build();
+        mutableShapes.add(new SupportShape(new Rect2d(0, 0, 1, 1), 5));
+        check(copied.support().shapes().isEmpty());
+        TechniqueTick idle = TechniqueTick.idle("waiting");
+        equal(idle.movement(), MovementCommand.NONE);
+        equal(idle.abortReason(), TechniqueAbortReason.NONE);
+        check(idle.rotation() == null && idle.placement() == null);
+
+        BridgeTechnique fake = new BridgeTechnique() {
+            private boolean begun;
+            public TechniqueId id() { return TechniqueId.STANDARD; }
+            public TechniqueCapabilities capabilities() {
+                return new TechniqueCapabilities(true, true, true, true, false,
+                        true, true, true, true, true, true, 0.2, 0.5);
+            }
+            public TechniqueEvaluation evaluate(BridgeContext supplied) {
+                return TechniqueEvaluation.compatible(1, 1, 0.5, supplied.player().grounded());
+            }
+            public void begin(BridgeContext supplied) { begun = supplied.player().alive(); }
+            public TechniqueTick tick(BridgeContext supplied) {
+                if (!begun) throw new IllegalStateException("not begun");
+                return new TechniqueTick(new MovementCommand(-1, 0), false, false,
+                        null, null, TechniqueAbortReason.NONE, true, "tick=" + supplied.tick());
+            }
+            public boolean canTransitionSafely(BridgeContext supplied) { return supplied.player().grounded(); }
+            public void abort(TechniqueAbortReason reason) { begun = false; }
+            public void reset() { begun = false; }
+        };
+        check(fake.evaluate(context).compatible());
+        fake.begin(context);
+        equal(fake.tick(context).debugState(), "tick=40");
+        check(fake.canTransitionSafely(context));
+    }
+
+    private static void expectIllegalArgument(Runnable action) {
+        assertions++;
+        try {
+            action.run();
+        } catch (IllegalArgumentException expected) {
+            return;
+        }
+        throw new AssertionError("assertion " + assertions + ": expected IllegalArgumentException");
+    }
+
+    private static void testPlacementPipeline() {
+        class FakePort implements PlacementAttemptPort, PlacementConfirmationPort {
+            int validations;
+            int pulses;
+            boolean confirmed;
+            public PlacementValidationResult validate() { validations++; return PlacementValidationResult.ok(); }
+            public boolean pulseUse(long tick) { pulses++; return true; }
+            public boolean confirmed(GridPos position) { return confirmed; }
+        }
+        FakePort port = new FakePort();
+        PlacementPipeline pipeline = new PlacementPipeline();
+        PlacementOwner owner = new PlacementOwner(1, "standard", 1);
+        GridPos pos = new GridPos(0, 4, -1);
+        PathStep step = PathStep.level(pos, new BridgeHeading(0, -1));
+        LogicalRotationRequest rotation = new LogicalRotationRequest(owner, new Rotation(180, 78), 2);
+        PlacementRequest request = new PlacementRequest(
+                owner, pos, AssistedPlacementKind.LEVEL, step, rotation, 10, 16);
+        equal(pipeline.attempt(request, owner, false, false, 10, 0, port).status(),
+                PlacementResult.Status.WAITING_ROTATION);
+        check(port.validations == 0 && port.pulses == 0);
+        equal(pipeline.attempt(request, owner, true, false, 10, 0, port).status(),
+                PlacementResult.Status.WAITING_CONFIRMATION);
+        equal(pipeline.attempt(request, owner, true, false, 10, 0, port).status(),
+                PlacementResult.Status.WAITING_CONFIRMATION);
+        check(port.validations == 1 && port.pulses == 1);
+        equal(pipeline.poll(owner, 11, port).status(), PlacementResult.Status.WAITING_CONFIRMATION);
+        port.confirmed = true;
+        equal(pipeline.poll(owner, 12, port).status(), PlacementResult.Status.CONFIRMED);
+        check(!pipeline.hasPending());
+
+        PlacementRequest lower = new PlacementRequest(
+                new PlacementOwner(1, "standard", 2), pos, AssistedPlacementKind.STAIR_LOWER,
+                step, new LogicalRotationRequest(new PlacementOwner(1, "standard", 2),
+                        new Rotation(180, 78), 2), 20, 21);
+        port.confirmed = false;
+        pipeline.attempt(lower, lower.owner(), true, false, 20, 0, port);
+        PlacementResult stale = pipeline.poll(new PlacementOwner(2, "standard", 2), 21, port);
+        equal(stale.status(), PlacementResult.Status.STALE_IGNORED);
+        check(!pipeline.hasPending());
+        pipeline.reset();
+        pipeline.attempt(lower, lower.owner(), true, false, 20, 0, port);
+        PlacementResult timeout = pipeline.poll(lower.owner(), 22, port);
+        equal(timeout.status(), PlacementResult.Status.TERMINAL_FAILURE);
+        equal(timeout.failure(), PlacementFailure.LOWER_PLACEMENT_FAILED);
+    }
+
     private static void testStateMachine() {
         BridgeStateMachine state = new BridgeStateMachine();
         state.begin();
