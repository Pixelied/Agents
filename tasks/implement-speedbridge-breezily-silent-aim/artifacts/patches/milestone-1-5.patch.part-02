+package dev.adrien.speedbridge.input;
+
+public record MovementCommand(double forward, double strafe) {
+    public static final MovementCommand NONE = new MovementCommand(0.0, 0.0);
+
+    public MovementCommand {
+        forward = clamp(forward);
+        strafe = clamp(strafe);
+    }
