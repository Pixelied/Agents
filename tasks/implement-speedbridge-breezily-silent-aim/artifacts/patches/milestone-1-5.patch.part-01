+public record BridgeSession(
+        long generation,
+        TechniqueId activeTechnique,
+        long startedTick
+) {
+    public BridgeSession {
+        if (generation < 1) throw new IllegalArgumentException("session generation must be positive");
+        if (activeTechnique == null) throw new IllegalArgumentException("active technique is required");
+        if (startedTick < 0) throw new IllegalArgumentException("startedTick must be non-negative");
+    }
+
+    public PlacementOwner owner(long operationGeneration) {
+        return new PlacementOwner(generation, activeTechnique.value(), operationGeneration);
+    }
+
+    public BridgeSession withTechnique(TechniqueId technique, long tick) {
+        return new BridgeSession(generation, technique, tick);
+    }
+}
