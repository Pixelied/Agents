--- /dev/null
+++ b/src/client/java/dev/adrien/speedbridge/mixin/KeyboardInputMixin.java
@@ -0,0 +1,36 @@
+package dev.adrien.speedbridge.mixin;
+
+import dev.adrien.speedbridge.input.MovementInputProjection;
+import dev.adrien.speedbridge.input.MovementOverrideState;
+import net.minecraft.client.player.KeyboardInput;
+import net.minecraft.world.entity.player.Input;
+import net.minecraft.world.phys.Vec2;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+@Mixin(KeyboardInput.class)
+public abstract class KeyboardInputMixin {
+    @Inject(method = "tick", at = @At("RETURN"))
+    private void speedbridge$applyMovementFrame(CallbackInfo ci) {
+        if (!MovementOverrideState.active()) return;
+
+        ClientInputAccessor accessor = (ClientInputAccessor) this;
+        Input current = accessor.speedbridge$getKeyPresses();
+        if (current == null) current = Input.EMPTY;
+
+        MovementInputProjection projection = MovementInputProjection.from(
+                MovementOverrideState.relativeCommand());
+        accessor.speedbridge$setKeyPresses(new Input(
+                projection.forward(),
+                projection.backward(),
+                projection.left(),
+                projection.right(),
+                current.jump(),
+                current.shift(),
+                current.sprint()));
+        accessor.speedbridge$setMoveVector(new Vec2(
+                projection.leftImpulse(), projection.forwardImpulse()));
+    }
+}
