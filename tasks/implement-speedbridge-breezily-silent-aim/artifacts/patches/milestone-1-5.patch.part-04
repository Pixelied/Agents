 }
diff --git a/src/client/java/dev/adrien/speedbridge/placement/MinecraftPlacementPort.java b/src/client/java/dev/adrien/speedbridge/placement/MinecraftPlacementPort.java
new file mode 100644
index 0000000000000000000000000000000000000000..d3beb1e616dcc90f714728dbb16c850964f6c9b2
--- /dev/null
+++ b/src/client/java/dev/adrien/speedbridge/placement/MinecraftPlacementPort.java
@@ -0,0 +1,76 @@
+package dev.adrien.speedbridge.placement;
+
+import dev.adrien.speedbridge.input.InputController;
+import dev.adrien.speedbridge.path.GridPos;
+import dev.adrien.speedbridge.selection.BlockSelection;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.player.LocalPlayer;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.phys.shapes.CollisionContext;
+
+public final class MinecraftPlacementPort implements PlacementAttemptPort, PlacementConfirmationPort {
+    private final Minecraft client;
+    private final PlacementValidator validator;
+    private final InputController inputController;
+    private final PlacementTarget target;
+    private final BlockSelection selection;
+
+    private MinecraftPlacementPort(
+            Minecraft client,
+            PlacementValidator validator,
+            InputController inputController,
+            PlacementTarget target,
+            BlockSelection selection
+    ) {
+        if (client == null) throw new IllegalArgumentException("client is required");
+        this.client = client;
+        this.validator = validator;
+        this.inputController = inputController;
+        this.target = target;
+        this.selection = selection;
+    }
+
+    public static MinecraftPlacementPort forAttempt(
+            Minecraft client,
+            PlacementValidator validator,
+            InputController inputController,
+            PlacementTarget target,
+            BlockSelection selection
+    ) {
+        if (validator == null || inputController == null || target == null || selection == null) {
+            throw new IllegalArgumentException("attempt dependencies are required");
+        }
+        return new MinecraftPlacementPort(client, validator, inputController, target, selection);
+    }
+
+    public static MinecraftPlacementPort forConfirmation(Minecraft client) {
+        return new MinecraftPlacementPort(client, null, null, null, null);
+    }
+
+    @Override
+    public PlacementValidationResult validate() {
+        if (validator == null || target == null || selection == null) {
+            throw new IllegalStateException("this port was not created for a placement attempt");
+        }
+        return validator.validate(client, target, selection.stack());
+    }
+
+    @Override
+    public boolean pulseUse(long tick) {
+        if (inputController == null) {
+            throw new IllegalStateException("this port was not created for a placement attempt");
+        }
+        return inputController.pulse(client, client.options.keyUse, tick, "use");
+    }
+
+    @Override
+    public boolean confirmed(GridPos position) {
+        LocalPlayer player = client.player;
+        if (player == null || position == null) return false;
+        BlockPos pos = new BlockPos(position.x(), position.y(), position.z());
+        BlockState state = player.level().getBlockState(pos);
+        return !state.isAir()
+                && !state.getCollisionShape(player.level(), pos, CollisionContext.of(player)).isEmpty();
+    }
+}
diff --git a/src/client/java/dev/adrien/speedbridge/placement/PendingPlacement.java b/src/client/java/dev/adrien/speedbridge/placement/PendingPlacement.java
index ecb4191ffa6c54436a3aef397411d08bfc649c79..e154f6c0c1c01339135f9ecd8113a52ca8196d2d 100644
