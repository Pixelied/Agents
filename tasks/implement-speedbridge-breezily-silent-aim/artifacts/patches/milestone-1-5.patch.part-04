+++ b/src/client/java/dev/adrien/speedbridge/placement/PendingPlacement.java
@@ -1,6 +1,19 @@
 package dev.adrien.speedbridge.placement;
 
+import dev.adrien.speedbridge.path.GridPos;
 import dev.adrien.speedbridge.path.PathStep;
-import net.minecraft.core.BlockPos;
 
-public record PendingPlacement(BlockPos position, AssistedPlacementKind kind, long requestedTick, PathStep step) {}
+public record PendingPlacement(
+        PlacementRequest request,
+        long requestedTick
+) {
+    public PendingPlacement {
+        if (request == null) throw new IllegalArgumentException("placement request is required");
+        if (requestedTick < 0) throw new IllegalArgumentException("requestedTick must be non-negative");
+    }
+
+    public GridPos position() { return request.replacePos(); }
+    public AssistedPlacementKind kind() { return request.kind(); }
+    public PathStep step() { return request.pathStep(); }
+    public PlacementOwner owner() { return request.owner(); }
+}
