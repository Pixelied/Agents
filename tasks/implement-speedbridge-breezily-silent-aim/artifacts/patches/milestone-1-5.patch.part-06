+            }
+            if (!owner.equals(request.owner())) {
+                throw new IllegalArgumentException("result owner must match request owner");
+            }
+        }
+        boolean failed = status == Status.RETRYABLE_FAILURE || status == Status.TERMINAL_FAILURE;
+        if (failed == (failure == PlacementFailure.NONE)) {
+            throw new IllegalArgumentException("failure status and failure reason must agree");
+        }
+    }
+
+    public static PlacementResult waitingRotation(PlacementRequest request) {
+        return of(Status.WAITING_ROTATION, request, PlacementFailure.NONE);
+    }
+
+    public static PlacementResult waitingConfirmation(PlacementRequest request) {
+        return of(Status.WAITING_CONFIRMATION, request, PlacementFailure.NONE);
+    }
+
+    public static PlacementResult confirmed(PlacementRequest request) {
+        return of(Status.CONFIRMED, request, PlacementFailure.NONE);
+    }
+
+    public static PlacementResult retryable(PlacementRequest request, PlacementFailure failure) {
+        return of(Status.RETRYABLE_FAILURE, request, requireFailure(failure));
+    }
+
+    public static PlacementResult terminal(PlacementRequest request, PlacementFailure failure) {
+        return of(Status.TERMINAL_FAILURE, request, requireFailure(failure));
+    }
+
+    public static PlacementResult staleIgnored(PlacementRequest request) {
+        return of(Status.STALE_IGNORED, request, PlacementFailure.NONE);
+    }
+
+    private static PlacementResult of(Status status, PlacementRequest request, PlacementFailure failure) {
+        if (request == null) throw new IllegalArgumentException("placement request is required");
+        return new PlacementResult(status, request.owner(), failure, request);
+    }
+
+    private static PlacementFailure requireFailure(PlacementFailure failure) {
+        if (failure == null || failure == PlacementFailure.NONE) {
+            throw new IllegalArgumentException("failure reason is required");
+        }
+        return failure;
+    }
+
+    public enum Status {
+        NOT_REQUESTED,
+        WAITING_ROTATION,
+        WAITING_CONFIRMATION,
+        CONFIRMED,
+        RETRYABLE_FAILURE,
+        TERMINAL_FAILURE,
+        STALE_IGNORED
+    }
+}
