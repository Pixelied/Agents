diff --git a/src/client/java/dev/adrien/speedbridge/technique/TechniqueCapabilities.java b/src/client/java/dev/adrien/speedbridge/technique/TechniqueCapabilities.java
new file mode 100644
index 0000000000000000000000000000000000000000..e27abc06e05415134c5f44c5b3d2cf7e0b54a748
--- /dev/null
+++ b/src/client/java/dev/adrien/speedbridge/technique/TechniqueCapabilities.java
@@ -0,0 +1,38 @@
+package dev.adrien.speedbridge.technique;
+
+import dev.adrien.speedbridge.aim.AimMode;
+
+public record TechniqueCapabilities(
+        boolean straight,
+        boolean diagonal,
+        boolean level,
+        boolean ascending,
+        boolean descending,
+        boolean visibleAim,
+        boolean silentAim,
+        boolean fullBlockSupport,
+        boolean routineSneak,
+        boolean routineJump,
+        boolean automaticEligible,
+        double riskScore,
+        double speedScore
+) {
+    public TechniqueCapabilities {
+        requireNormalized(riskScore, "riskScore");
+        requireNormalized(speedScore, "speedScore");
+    }
+
+    public boolean supports(AimMode mode) {
+        if (mode == null) return false;
+        return switch (mode) {
+            case VISIBLE -> visibleAim;
+            case SILENT_PACKET -> silentAim;
+        };
+    }
+
+    private static void requireNormalized(double value, String name) {
+        if (!Double.isFinite(value) || value < 0.0 || value > 1.0) {
+            throw new IllegalArgumentException(name + " must be between 0 and 1");
+        }
+    }
+}
