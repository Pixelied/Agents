+package dev.adrien.speedbridge.technique;
+
+public record TechniqueEvaluation(
+        boolean compatible,
+        String reason,
+        double readinessScore,
+        double safetyConfidence,
+        double speedScore,
+        boolean safeEntryNow
+) {
+    public TechniqueEvaluation {
+        reason = reason == null ? "" : reason;
+        requireNormalized(readinessScore, "readinessScore");
+        requireNormalized(safetyConfidence, "safetyConfidence");
+        requireNormalized(speedScore, "speedScore");
+        if (!compatible && reason.isBlank()) {
+            throw new IllegalArgumentException("incompatible evaluations require a reason");
+        }
+    }
+
+    public static TechniqueEvaluation compatible(
