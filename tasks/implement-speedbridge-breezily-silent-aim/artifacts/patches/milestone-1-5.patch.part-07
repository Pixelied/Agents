+            double readinessScore,
+            double safetyConfidence,
+            double speedScore,
+            boolean safeEntryNow
+    ) {
+        return new TechniqueEvaluation(true, "", readinessScore, safetyConfidence, speedScore, safeEntryNow);
+    }
+
+    public static TechniqueEvaluation incompatible(String reason) {
+        return new TechniqueEvaluation(false, reason, 0.0, 0.0, 0.0, false);
+    }
+
+    private static void requireNormalized(double value, String name) {
+        if (!Double.isFinite(value) || value < 0.0 || value > 1.0) {
+            throw new IllegalArgumentException(name + " must be between 0 and 1");
+        }
+    }
+}
diff --git a/src/client/java/dev/adrien/speedbridge/technique/TechniqueId.java b/src/client/java/dev/adrien/speedbridge/technique/TechniqueId.java
new file mode 100644
index 0000000000000000000000000000000000000000..a36aee11acc3be6dbdd8a29748b7a62c23ce6b6d
--- /dev/null
+++ b/src/client/java/dev/adrien/speedbridge/technique/TechniqueId.java
@@ -0,0 +1,16 @@
+package dev.adrien.speedbridge.technique;
+
+import java.util.Locale;
+
+public record TechniqueId(String value) {
+    public static final TechniqueId STANDARD = new TechniqueId("standard");
+    public static final TechniqueId BREEZILY = new TechniqueId("breezily");
+
+    public TechniqueId {
+        if (value == null) throw new IllegalArgumentException("technique id is required");
+        value = value.trim().toLowerCase(Locale.ROOT);
+        if (!value.matches("[a-z0-9][a-z0-9-]*")) {
+            throw new IllegalArgumentException("invalid technique id: " + value);
+        }
+    }
+}
diff --git a/src/client/java/dev/adrien/speedbridge/technique/TechniqueTick.java b/src/client/java/dev/adrien/speedbridge/technique/TechniqueTick.java
new file mode 100644
index 0000000000000000000000000000000000000000..c9933703b2efe40b42fccdc670883cc1cd5f8d52
--- /dev/null
+++ b/src/client/java/dev/adrien/speedbridge/technique/TechniqueTick.java
@@ -0,0 +1,35 @@
+package dev.adrien.speedbridge.technique;
+
+import dev.adrien.speedbridge.aim.LogicalRotationRequest;
+import dev.adrien.speedbridge.input.MovementCommand;
+import dev.adrien.speedbridge.placement.PlacementRequest;
+
+public record TechniqueTick(
+        MovementCommand movement,
+        boolean sneak,
+        boolean jump,
+        LogicalRotationRequest rotation,
+        PlacementRequest placement,
+        TechniqueAbortReason abortReason,
+        boolean safeTransitionPoint,
+        String debugState
+) {
+    public TechniqueTick {
+        if (movement == null || abortReason == null) {
+            throw new IllegalArgumentException("movement and abort reason are required");
+        }
+        debugState = debugState == null ? "" : debugState;
+        if (placement != null && rotation == null) {
+            throw new IllegalArgumentException("placement requests require a logical rotation");
+        }
+        if (placement != null && !placement.rotation().equals(rotation)) {
+            throw new IllegalArgumentException("tick rotation must match placement rotation");
+        }
+    }
+
+    public static TechniqueTick idle(String state) {
+        return new TechniqueTick(
+                MovementCommand.NONE, false, false, null, null,
+                TechniqueAbortReason.NONE, false, state);
+    }
+}
