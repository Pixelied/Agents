diff --git a/src/test/java/dev/adrien/speedbridge/controller/ControllerLifecycleRegressionTest.java b/src/test/java/dev/adrien/speedbridge/controller/ControllerLifecycleRegressionTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..fa7d79d62658d4efdb0b03d23e12223878205996
--- /dev/null
+++ b/src/test/java/dev/adrien/speedbridge/controller/ControllerLifecycleRegressionTest.java
@@ -0,0 +1,26 @@
+package dev.adrien.speedbridge.controller;
+
+import dev.adrien.speedbridge.path.BridgeHeading;
+import dev.adrien.speedbridge.path.GridPos;
+import dev.adrien.speedbridge.path.PathStep;
+import dev.adrien.speedbridge.stair.StaircaseCycle;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class ControllerLifecycleRegressionTest {
+    private static final PathStep STEP = new PathStep(
+            new GridPos(0, 5, -1), new GridPos(0, 6, -1), new BridgeHeading(0, -1));
+
+    @Test
+    void timedOutPlacementFromAnAbortedCycleCannotCreateAnActiveNullStep() {
+        StaircaseCycle staircase = new StaircaseCycle();
+        staircase.start(STEP, 10);
+
+        staircase.reset(); // grounded abort clears the path step
+        staircase.lowerFailed(); // stale pending-placement timeout arrives later
+
+        assertFalse(staircase.active());
+        assertNull(staircase.step());
+    }
+}
diff --git a/src/test/java/dev/adrien/speedbridge/input/BackwardMovementRegressionTest.java b/src/test/java/dev/adrien/speedbridge/input/BackwardMovementRegressionTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..f473299e776ae02bd2d4d0696602f97f557c586e
--- /dev/null
+++ b/src/test/java/dev/adrien/speedbridge/input/BackwardMovementRegressionTest.java
@@ -0,0 +1,28 @@
+package dev.adrien.speedbridge.input;
+
+import dev.adrien.speedbridge.util.Vec2d;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class BackwardMovementRegressionTest {
+    @Test
+    void rawPhysicalBackwardReversesWorldDirectionAfterAOneEightyDegreeAimTurn() {
+        Vec2d bridgeBackward = Vec2d.fromYawDegrees(0).scale(-1).normalized();
+        Vec2d rawSAfterAimTurn = Vec2d.fromYawDegrees(180).scale(-1).normalized();
+
+        assertEquals(-1.0, bridgeBackward.dot(rawSAfterAimTurn), 1.0e-9,
+                "camera-relative S points opposite the committed bridge direction after a 180 degree aim turn");
+    }
+
+    @Test
+    void adapterKeepsBackwardOnTheCapturedBridgeAxisAfterAimTurn() {
+        MovementFrame frame = MovementFrame.fromReferenceYaw(0.0f);
+        Vec2d desired = MovementFrameAdapter.worldDirection(frame, new MovementCommand(-1.0, 0.0));
+        MovementCommand relativeAtPlacementYaw = MovementFrameAdapter.relativeToYaw(desired, 180.0f);
+        Vec2d actual = MovementFrameAdapter.worldDirection(
+                MovementFrame.fromReferenceYaw(180.0f), relativeAtPlacementYaw);
+
+        assertTrue(actual.dot(frame.backwardAxis()) >= 0.999);
+    }
+}
diff --git a/src/test/java/dev/adrien/speedbridge/input/MovementFrameAdapterTest.java b/src/test/java/dev/adrien/speedbridge/input/MovementFrameAdapterTest.java
new file mode 100644
index 000000000000000000000000000000000000000..5ea50ad3d99ff3b04e7c4595d6e2f894b7ffc685
--- /dev/null
+++ b/src/test/java/dev/adrien/speedbridge/input/MovementFrameAdapterTest.java
@@ -0,0 +1,81 @@
+package dev.adrien.speedbridge.input;
+
+import dev.adrien.speedbridge.util.Vec2d;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.*;
+
+final class MovementFrameAdapterTest {
+    @Test
+    void physicalBackwardMapsToCommittedBridgeBackwardAtCapturedRotation() {
+        MovementFrame frame = MovementFrame.fromReferenceYaw(0.0f);
+        RawInputIntent raw = new RawInputIntent(false, true, false, false, false, false, false);
+
+        Vec2d world = MovementFrameAdapter.worldDirection(frame, raw.movementCommand());
+        assertTrue(world.dot(frame.backwardAxis()) > 0.999);
+    }
+
+    @Test
+    void convertsWorldBackwardToRelativeKeysAfterPlacementYawTurns(){
+        MovementFrame frame = MovementFrame.fromReferenceYaw(0.0f);
+        Vec2d worldBackward = frame.backwardAxis();
+
+        MovementCommand relative = MovementFrameAdapter.relativeToYaw(worldBackward, 180.0f);
+        Vec2d resolved = MovementFrameAdapter.worldDirection(
+                MovementFrame.fromReferenceYaw(180.0f), relative);
+
+        assertTrue(resolved.dot(worldBackward) > 0.999);
+    }
+
+    @Test
+    void mixedPhysicalAndSyntheticMovementRemainsDiagonal(){
+        MovementFrame frame = MovementFrame.fromReferenceYaw(0.0f);
+        RawInputIntent raw = new RawInputIntent(false, true, true, false, false, false, false);
+
+        Vec2d world = MovementFrameAdapter.worldDirection(frame, raw.movementCommand());
+        assertTrue(world.dot(frame.backwardAxis()) > 0.69);
+        assertTrue(world.dot(frame.rightAxis()) < 0.0);
+    }
+
+    @Test
+    void inputProjectionPreservesNonMovementButtons() {
+        MovementInputProjection projection = MovementInputProjection.from(
+                new MovementCommand(-1.0, 0.5));
+
+        assertTrue(projection.backward());
+        assertTrue(projection.right());
+        assertFalse(projection.forward());
+        assertFalse(projection.left());
