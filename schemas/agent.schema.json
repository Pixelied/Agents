{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents/agent.schema.json",
  "title": "Agent profile",
  "type": "object",
  "required": ["schema_version", "protocol_version", "agent_id", "provider", "model", "capabilities", "registered_at", "state"],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_version": {"const": "1.0"},
    "agent_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "registered_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["available", "busy", "offline"]}
  },
  "additionalProperties": false
}
