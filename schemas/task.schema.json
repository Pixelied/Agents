{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents/task.schema.json",
  "title": "Task definition",
  "type": "object",
  "required": ["schema_version", "protocol_version", "task_id", "title", "objective", "created_by", "created_at", "priority", "status", "scopes", "acceptance_criteria"],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "priority": {"enum": ["low", "normal", "high", "critical"]},
    "status": {"enum": ["open", "blocked", "completed", "cancelled"]},
    "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
