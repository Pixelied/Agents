+    /**
+     * Queues a complete wire sphere as one world batch. This is primarily used
+     * by the Fabric renderer to replace GLU/immediate-mode sphere drawing.
+     */
+    public static void drawWireSphere(float radius, int slices, int stacks, float lineWidth, Color color) {
+        slices = Math.max(3, slices);
+        stacks = Math.max(2, stacks);
+        int segmentCount = (stacks - 1) * slices + stacks * slices;
+        RenderBatchBuilder builder = new RenderBatchBuilder(
+                segmentCount * 2, VertexCoordinateMode.DEFAULT, true);
+
+        double twoPi = Math.PI * 2.0;
+        for (int stack = 1; stack < stacks; stack++) {
+            double theta = -Math.PI * 0.5 + Math.PI * stack / stacks;
+            float y = (float) (radius * Math.sin(theta));
+            float ringRadius = (float) (radius * Math.cos(theta));
+            for (int slice = 0; slice < slices; slice++) {
+                double phi0 = twoPi * slice / slices;
+                double phi1 = twoPi * (slice + 1) / slices;
+                builder.addLine(
+                        (float) (ringRadius * Math.cos(phi0)), y, (float) (ringRadius * Math.sin(phi0)),
+                        (float) (ringRadius * Math.cos(phi1)), y, (float) (ringRadius * Math.sin(phi1)),
+                        lineWidth, color);
+            }
+        }
+
+        for (int slice = 0; slice < slices; slice++) {
+            double phi = twoPi * slice / slices;
+            for (int stack = 0; stack < stacks; stack++) {
+                double theta0 = -Math.PI * 0.5 + Math.PI * stack / stacks;
+                double theta1 = -Math.PI * 0.5 + Math.PI * (stack + 1) / stacks;
+                float cosPhi = (float) Math.cos(phi);
+                float sinPhi = (float) Math.sin(phi);
+                float ring0 = (float) (radius * Math.cos(theta0));
+                float ring1 = (float) (radius * Math.cos(theta1));
+                builder.addLine(
+                        ring0 * cosPhi, (float) (radius * Math.sin(theta0)), ring0 * sinPhi,
+                        ring1 * cosPhi, (float) (radius * Math.sin(theta1)), ring1 * sinPhi,
+                        lineWidth, color);
+            }
+        }
+
+        RenderBatchManager.getInstance().queueWorldBatch(builder);
+    }
+
+    /** Queues a tessellated solid sphere as one world batch. */
+    public static void fillSphere(float radius, int slices, int stacks, Color color) {
+        slices = Math.max(3, slices);
+        stacks = Math.max(2, stacks);
+        RenderBatchBuilder builder = new RenderBatchBuilder(
+                slices * stacks * 4, VertexCoordinateMode.DEFAULT, true);
+        double twoPi = Math.PI * 2.0;
+
+        for (int stack = 0; stack < stacks; stack++) {
+            double theta0 = -Math.PI * 0.5 + Math.PI * stack / stacks;
+            double theta1 = -Math.PI * 0.5 + Math.PI * (stack + 1) / stacks;
+            float y0 = (float) (radius * Math.sin(theta0));
+            float y1 = (float) (radius * Math.sin(theta1));
+            float ring0 = (float) (radius * Math.cos(theta0));
+            float ring1 = (float) (radius * Math.cos(theta1));
+
+            for (int slice = 0; slice < slices; slice++) {
+                double phi0 = twoPi * slice / slices;
+                double phi1 = twoPi * (slice + 1) / slices;
+                float c0 = (float) Math.cos(phi0);
+                float s0 = (float) Math.sin(phi0);
+                float c1 = (float) Math.cos(phi1);
+                float s1 = (float) Math.sin(phi1);
+
+                builder.addQuad(
+                        ring0 * c0, y0, ring0 * s0,
+                        ring1 * c0, y1, ring1 * s0,
+                        ring0 * c1, y0, ring0 * s1,
+                        ring1 * c1, y1, ring1 * s1,
+                        color);
+            }
+        }
+
+        RenderBatchManager.getInstance().queueWorldBatch(builder);
+    }
+
     public static void fillQuad(double x1, double y1, double z1, double x2, double y2, double z2, double x3, double y3, double z3, double x4, double y4, double z4, Color color) {
         BufferedRenderPrimitives.fillQuad((float)x1, (float)y1, (float)z1, (float)x2, (float)y2, (float)z2, (float)x3, (float)y3, (float)z3, (float)x4, (float)y4, (float)z4, color);
     }
